{
  "name": "teruisi-operations-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node tools/install-workerd-heap-patch.mjs",
    "preview:isolated": "node tools/preview/launcher.mjs start --open",
    "preview:prepare": "node tools/preview/launcher.mjs prepare",
    "preview:status": "node tools/preview/launcher.mjs status",
    "preview:stop": "node tools/preview/launcher.mjs stop",
    "preview:snapshot": "node tools/preview/launcher.mjs snapshot",
    "preview:restore": "node tools/preview/launcher.mjs restore",
    "preview:verify": "node tools/preview/smoke.mjs",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/worker-local-service.ps1 -Action Start",
    "build": "vinext build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/worker-local-service.ps1 -Action Start",
    "start:local-worker": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/worker-local-service.ps1 -Action Start",
    "system:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/operations-system-control.ps1 -Action Status",
    "system:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/operations-system-service.ps1 -Action Start",
    "system:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/operations-system-service.ps1 -Action Stop",
    "system:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/operations-system-service.ps1 -Action Restart -KeepBackend",
    "system:restart:full": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/operations-system-service.ps1 -Action Restart",
    "system:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/operations-system-service.ps1 -Action Logs",
    "backend:dev": "node tools/django-dev-backend.mjs start",
    "backend:dev:stop": "node tools/django-dev-backend.mjs stop",
    "backend:dev:status": "node tools/django-dev-backend.mjs status",
    "backend:dev:logs": "node tools/django-dev-backend.mjs logs",
    "test": "vinext build && node --import tsx --test tests/*.test.ts && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .runtime --ignore-pattern .codex-tmp --ignore-pattern .vite-sites-cache --ignore-pattern tmp --ignore-pattern outputs",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "check:backend-boundary": "node tools/check-django-production-boundary.mjs",
    "jackyun:post-download": "node --import tsx tools/jackyun-download-runner.ts",
    "jackyun:daily": "node --import tsx tools/jackyun-automation-runner.ts",
    "jackyun:browser": "node --import tsx tools/jackyun-browser-controller.ts",
    "jackyun:login": "node --import tsx tools/jackyun-browser-login.ts",
    "jackyun:credential:setup": "node --import tsx tools/jackyun-credential.ts setup",
    "jackyun:credential:status": "node --import tsx tools/jackyun-credential.ts status",
    "jackyun:authenticate": "node --import tsx tools/jackyun-browser-controller.ts --authenticate-only",
    "jackyun:ware-export": "node --import tsx tools/jackyun-ware-export.ts",
    "jackyun:day-sku-export": "node --import tsx tools/jackyun-day-sku-export.ts",
    "jdsz:product-detail-export": "node --import tsx tools/jdsz-product-detail-export.ts",
    "jd:all-stores": "node --import tsx tools/jd-multi-store-runner.ts",
    "jd:credential:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/jd-credential-vault.ps1 -Action setup",
    "jd:promotion": "node --import tsx tools/jd-promotion-export.ts",
    "netshop:promotion:backfill": "node tools/retired-d1-command.mjs",
    "tmall:receipt": "node --import tsx tools/tmall-download-receipt.ts",
    "tmall:daily:import": "node --import tsx tools/tmall-multi-store-import-runner.ts",
    "tmall:login": "node --import tsx tools/tmall-product-master-export.ts --launch-only",
    "tmall:credential:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/tmall-credential-vault.ps1 -Action setup",
    "tmall:n8n:generate": "node --import tsx tools/generate-tmall-n8n-workflows.ts",
    "n8n:retry:generate": "node tools/generate-n8n-hourly-retry-workflows.mjs",
    "market:annotation-agent": "node --import tsx tools/market-annotation-runner.ts",
    "market:annotation-cloud-pump": "node --import tsx tools/market-annotation-cloud-pump.ts",
    "market:image-repair": "node --import tsx tools/jd-market-image-repair.ts",
    "jackyun:run": "node --import tsx tools/jackyun-automation-runner.ts",
    "jackyun:continue-helper": "node --import tsx tools/jackyun-continue-helper.ts",
    "erp:sales:run": "node --import tsx tools/erp-sales-automation.ts",
    "erp:sales:login": "node --import tsx tools/erp-sales-automation.ts --login",
    "sales:import": "node --import tsx tools/sales-import-runner.ts",
    "dingtalk:robot:send": "node --import tsx tools/dingtalk-custom-robot-send.ts",
    "db:generate": "node tools/drizzle-generate-guard.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.4",
    "next": "16.2.6",
    "playwright-core": "1.61.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vinext": "^0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
