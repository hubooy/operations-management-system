# Vite/Vinext content-hashed bundles and generated fonts.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Versionless public metadata/assets: cache briefly, but never immutably.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/file.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/globe.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/window.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
