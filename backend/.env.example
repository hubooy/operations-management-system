# Development only. Production must supply a long random value.
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TERUISI_DJANGO_ENVIRONMENT=development
TERUISI_DJANGO_PROCESS_ROLE=development
TERUISI_DJANGO_EXPECT_READ_ONLY=false
# Production roles additionally include the isolated finance, netshop, market,
# and products reader/writer pairs.
# Required only by the isolated sales_writer process after an explicit CAS cutover.
TERUISI_DJANGO_SALES_AUTHORITY_EPOCH=
TERUISI_DJANGO_SALES_CUTOVER_ID=
# Required only by the isolated finance_writer process after an explicit
# finance authority cutover. Never copy the sales authority values here.
TERUISI_DJANGO_FINANCE_AUTHORITY_EPOCH=
TERUISI_DJANGO_FINANCE_CUTOVER_ID=
TERUISI_DJANGO_PRODUCTS_AUTHORITY_EPOCH=
TERUISI_DJANGO_PRODUCTS_CUTOVER_ID=
TERUISI_DJANGO_LOG_LEVEL=INFO

# Omit to use the local SQLite database at .runtime/django/teruisi.sqlite3.
# PostgreSQL example: postgresql://user:password@127.0.0.1:5432/teruisi
TERUISI_DJANGO_DATABASE_URL=

# Shared only by the Cloudflare/Next edge adapter and this Django service.
TERUISI_DJANGO_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
TERUISI_DJANGO_ACCESS_CONTROL_READER_BASE_URL=http://127.0.0.1:8101
TERUISI_DJANGO_ACCESS_CONTROL_WRITER_BASE_URL=http://127.0.0.1:8102
# AI edge adapters use separate reader/writer; no legacy fallback is supported.
TERUISI_DJANGO_AI_READER_BASE_URL=http://127.0.0.1:8111
TERUISI_DJANGO_AI_WRITER_BASE_URL=http://127.0.0.1:8112
# Both AI processes require the exact activated AI authority identity.
TERUISI_DJANGO_AI_AUTHORITY_EPOCH=
TERUISI_DJANGO_AI_CUTOVER_ID=
TERUISI_DJANGO_AI_EDGE_BASE_URL=http://127.0.0.1:3000
# Production model encryption key is transferred from the existing Worker key
# into a separate DPAPI credential store. Never generate a replacement key.
AI_SECRET_ENCRYPTION_KEY=
AI_MODEL_ENDPOINT_ORIGIN_ALLOWLIST=
TERUISI_DJANGO_SIGNATURE_MAX_AGE_SECONDS=60
TERUISI_DJANGO_SALES_CACHE_SECONDS=300
TERUISI_DJANGO_ERP_SYNC_MAX_AGE_SECONDS=60
TERUISI_DJANGO_DB_CONN_MAX_AGE=60
TERUISI_DJANGO_MAX_HEADER_BYTES=32768
# Reader default is 1 MiB; sales_writer defaults to 8 MiB and finance_writer
# defaults to 16 MiB; products_writer defaults to 32 MiB for normalized payloads.
TERUISI_DJANGO_MAX_BODY_BYTES=1048576

# The local production launcher starts disjoint reader (8001) and sales_writer
# (8002) processes with loopback PostgreSQL and DPAPI-backed secrets.
# Finance rollout uses separate finance_reader/finance_writer processes and
# distinct loopback endpoints; it must not reuse the sales reader/writer URL.
